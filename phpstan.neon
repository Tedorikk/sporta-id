includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    # Level 5 is clean. Level 6 adds ~250 missing-annotation errors across the
    # older controllers; raise it once those carry return and iterable types.
    level: 5
